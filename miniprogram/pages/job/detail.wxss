/* 岗位详情（F9-B） */
.top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
}
.salary {
  font-size: 34rpx;
  color: #e5484d;
  font-weight: 700;
}
.company {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #4A90D9;
}
.info-row {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666666;
}
.desc {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}
.trust-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}
.trust-row {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666666;
}
.risk {
  color: #e6a23c;
  font-weight: 600;
}
.resume-label {
  font-size: 26rpx;
  color: #666666;
}
.resume-input {
  margin-top: 12rpx;
  width: 100%;
  height: 180rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.apply-btn {
  width: 100%;
  margin-top: 24rpx;
}
.retry {
  margin: 24rpx auto 0;
  width: 240rpx;
}
