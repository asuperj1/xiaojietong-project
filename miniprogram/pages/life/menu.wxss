/* 商家菜单（F9-D） */
.menu-page {
  padding-bottom: 360rpx;
}
.head {
  margin: 0 24rpx 20rpx;
}
.head-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
}
.menu-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.menu-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}
.menu-price {
  font-size: 30rpx;
  color: #e5484d;
  font-weight: 700;
}
.menu-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
}
.menu-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}
.counter {
  display: flex;
  align-items: center;
}
.counter-btn {
  width: 56rpx;
  height: 56rpx;
  background: #f2f2f2;
  border-radius: 50%;
  text-align: center;
  line-height: 52rpx;
  font-size: 32rpx;
  color: #666666;
}
.counter-plus {
  background: #4A90D9;
  color: #ffffff;
}
.counter-num {
  min-width: 60rpx;
  text-align: center;
  font-size: 28rpx;
}
.checkout {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-top: 1rpx solid #eeeeee;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}
.ck-fields {
  display: flex;
  flex-wrap: wrap;
}
.ck-input {
  width: 48%;
  margin-right: 2%;
  height: 64rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}
.ck-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}
.ck-total {
  font-size: 28rpx;
  color: #333333;
}
.ck-btn {
  width: 240rpx;
}
.retry {
  margin: 24rpx auto 0;
  width: 240rpx;
}
