/* 订单详情（F9-D） */
.top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.status {
  font-size: 32rpx;
  font-weight: 600;
  color: #4A90D9;
}
.pay {
  font-size: 32rpx;
  color: #e5484d;
  font-weight: 700;
}
.time {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999999;
}
.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}
.item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #333333;
  border-bottom: 1rpx solid #f5f5f5;
}
.item:last-child {
  border-bottom: none;
}
.retry {
  margin: 24rpx auto 0;
  width: 240rpx;
}
