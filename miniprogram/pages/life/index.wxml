<!-- 生活服务·外卖点餐（F9-D） -->
<view class="xj-page">
  <view class="tabs">
    <view class="tab {{catIndex === index ? 'tab-active' : ''}}" wx:for="{{cats}}" wx:key="*this" data-index="{{index}}" bindtap="onCatChange">{{item}}</view>
  </view>

  <view wx:if="{{loading}}" class="xj-loading">加载中…</view>

  <block wx:elif="{{error}}">
    <view class="xj-empty">
      <text class="xj-empty-icon">⚠️</text>{{error}}
      <view><button class="xj-btn-plain retry" bindtap="fetch">重试</button></view>
    </view>
  </block>

  <block wx:elif="{{items.length === 0}}">
    <view class="xj-empty"><text class="xj-empty-icon">🍜</text>暂无商家</view>
  </block>

  <block wx:else>
    <view class="xj-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="onItemTap">
      <view class="m-top">
        <text class="m-name">{{item.name}}</text>
        <text class="m-category">{{item.category}}</text>
      </view>
      <view class="m-sub" wx:if="{{item.address}}">{{item.address}}</view>
      <view class="m-meta" wx:if="{{item.delivery_fee != null || item.min_order != null}}">
        <text wx:if="{{item.avg_score != null}}">评分 {{item.avg_score}}</text>
        <text wx:if="{{item.min_order != null}}">起送 ¥{{item.min_order}}</text>
        <text wx:if="{{item.delivery_fee != null}}">配送费 ¥{{item.delivery_fee}}</text>
      </view>
    </view>
  </block>
</view>
