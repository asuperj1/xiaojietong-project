/* 服务页（业务大宫格） */
.grid-card {
  display: flex;
  flex-wrap: wrap;
  background: #ffffff;
  border-radius: 24rpx;
  margin: 0 24rpx;
  padding: 16rpx 0;
}
.grid-item {
  width: 25%;
  text-align: center;
  padding: 24rpx 0;
  box-sizing: border-box;
}
.grid-icon {
  width: 96rpx;
  height: 96rpx;
  display: block;
  margin: 0 auto;
}
.grid-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #333333;
}

/* F12：为 fixed 定位的自定义 TabBar 自留底部空间（原生 tabBar 由框架预留，自定义不会）。
   留白 = 底栏占用高度(110rpx + 安全区) + 24rpx 呼吸位；改动需同步 custom-tab-bar/index.wxss。 */
.xj-page {
  padding-bottom: calc(134rpx + env(safe-area-inset-bottom));
}
