/* ============================================================
   服务页（需求 7 / F15）—— 顶部「路线维保中心」吸顶卡 + 8 功能 2×4 玻璃宫格
   依据：docs/二阶段整改方案-前端UI重构与后端支撑.md §2.3
         视觉规范 §1.1（液态玻璃 / 圆角 / 主色）、§1.2（三层降级）、§1.3（按压缩放）
   玻璃与令牌：复用 app.wxss 全局引入的 styles/tokens.wxss + styles/glass.wxss；
              本文件只写本页布局与取值，不新增主题变量、不改公共样式。
   能力降级：根节点 .is-glass-fallback 由 service.js 读 globalData.glassSupported 决定
             （第三层运行时降级，规则见 styles/glass.wxss）。
   ============================================================ */

/* ---- 页面容器：低饱和渐变底 ----
   玻璃要有背景层才看得到模糊；不用 .xj-page（其 24rpx 上内边距会把通栏卡片推离顶部）。 */
.svc-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* ---- 吸顶容器（需求 7「position: sticky 吸顶」）----
   sticky 的吸附范围 = 父级 .svc-page 的高度（贯穿整页），故滚动全程保持吸附；
   不支持 sticky 的环境退化为「普通顶部卡片」，页面仍完整可用（渐进增强，不做 JS 兜底）。 */
.svc-sticky {
  position: sticky;
  top: 0;
  z-index: 10; /* 吸顶后浮在宫格之上 */
}

/* ---- 路线维保中心：通栏长玻璃卡片 ----
   通栏 → 左右不留白、上方贴齐屏幕；仅下方两角收圆，吸顶时是一块完整的顶部玻璃条。 */
.svc-maint.xj-glass-card {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding: var(--xj-space-sm, 16rpx) var(--xj-space-md, 24rpx);
  border-radius: 0 0 28rpx 28rpx;
  border-radius: 0 0 var(--xj-radius-panel, 28rpx) var(--xj-radius-panel, 28rpx);
  transition: opacity var(--xj-duration-fast, 150ms) var(--xj-ease-press, cubic-bezier(0.4, 0, 0.2, 1));
}
/* 按压反馈（§1.3：150ms + 按压缓动）：通栏卡片不做缩放，改为轻微变淡 */
.svc-maint--pressed {
  opacity: 0.88;
}

/* 图标底座：主色浅底（令牌 --xj-color-primary-soft） */
.svc-maint-icon {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  margin-right: 16rpx;
  margin-right: var(--xj-space-sm, 16rpx);
  border-radius: 24rpx;
  border-radius: var(--xj-radius-card, 24rpx);
  background: rgba(74, 144, 217, 0.12);
  background: var(--xj-color-primary-soft, rgba(74, 144, 217, 0.12));
  display: flex;
  align-items: center;
  justify-content: center;
}
/* §1.5：功能卡图标 56rpx（<image> 内无 CSS 上下文，线性 SVG 渲染为细线，见 icons/README §3） */
.svc-maint-icon-img {
  width: 56rpx;
  height: 56rpx;
  display: block;
}

.svc-maint-main {
  flex: 1;
  min-width: 0; /* 允许下方 .svc-maint-sub 省略号截断 */
}
.svc-maint-title {
  font-size: 32rpx;
  font-size: var(--xj-font-size-lg, 32rpx);
  font-weight: 600;
  font-weight: var(--xj-font-weight-semibold, 600);
  color: #1F2329;
  color: var(--xj-text-primary, #1F2329);
  line-height: 1.4;
}
.svc-maint-sub {
  margin-top: 8rpx;
  margin-top: var(--xj-space-xs, 8rpx);
  font-size: 24rpx;
  font-size: var(--xj-font-size-sm, 24rpx);
  color: #8A9099;
  color: var(--xj-text-secondary, #8A9099);
  line-height: 1.4;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* 右侧指示箭头：纯 CSS 描边绘制，不新增图标资产（F11 图标清单为 README 锁定的 12 个） */
.svc-maint-arrow {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  margin-left: 16rpx;
  margin-left: var(--xj-space-sm, 16rpx);
  border-top: 2rpx solid #8A9099;
  border-top-color: var(--xj-text-secondary, #8A9099);
  border-right: 2rpx solid #8A9099;
  border-right-color: var(--xj-text-secondary, #8A9099);
  transform: rotate(45deg);
}

/* ---- 8 功能宫格：2 行 × 4 列 ---- */
.svc-grid {
  display: flex;
  flex-wrap: wrap; /* 每行 4 个（25% 宽）→ 8 个正好 2 行 */
  padding: 24rpx 8rpx 0;
  padding: var(--xj-space-md, 24rpx) var(--xj-space-xs, 8rpx) 0;
}
/* 单元格：承担「四列宽度 + 卡片间距 + 点击热区」，玻璃面在内层卡片上 */
.svc-tile {
  width: 25%;
  padding: 8rpx;
  padding: var(--xj-space-xs, 8rpx);
  box-sizing: border-box;
  transition: transform var(--xj-duration-fast, 150ms) var(--xj-ease-press, cubic-bezier(0.4, 0, 0.2, 1));
}
/* 按压反馈（§1.3：scale(.96) / 150ms） */
.svc-pressed {
  transform: scale(0.96);
}
/* 圆角方形玻璃卡片：几何沿用 .xj-glass-card，仅按宫格尺寸收窄左右内边距（5 字条目不折行） */
.svc-tile-card.xj-glass-card {
  min-height: 160rpx;
  padding: 24rpx 8rpx;
  padding: var(--xj-space-md, 24rpx) var(--xj-space-xs, 8rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
}
.grid-icon {
  width: 56rpx;
  height: 56rpx;
  display: block;
}
.grid-name {
  margin-top: 8rpx;
  margin-top: var(--xj-space-xs, 8rpx);
  font-size: 24rpx;
  font-size: var(--xj-font-size-sm, 24rpx);
  line-height: 1.4;
  color: #1F2329;
  color: var(--xj-text-primary, #1F2329);
}
