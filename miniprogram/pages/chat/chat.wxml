<!-- AI 对话页（F4）：顶部操作条 + 消息列表 + 底部输入 -->
<!-- F14-A：顶部【菜单】按钮 → 从左侧滑出侧边栏（新建会话 + 会话列表 + 长按删除） -->
<view class="chat-page {{glassClass}}">
  <!-- 顶部操作条：【菜单】/【+ 新会话】/【历史】（后两个是 F4 原有入口，保留） -->
  <view class="top-bar">
    <view class="top-bar-left">
      <button class="top-btn" bindtap="onOpenSidebar">菜单</button>
      <button class="top-btn" bindtap="onNewConversation">+ 新会话</button>
    </view>
    <button class="top-btn" bindtap="onHistory">历史</button>
  </view>

  <scroll-view
    class="msg-scroll"
    scroll-y
    scroll-into-view="{{scrollIntoView}}"
    scroll-with-animation
  >
    <!-- 空会话欢迎 -->
    <view wx:if="{{messages.length === 0}}" class="welcome">
      <view class="welcome-icon">🤖</view>
      <view class="welcome-title">你好，我是校捷通 AI 助手</view>
      <view class="welcome-sub">关于校园的一切，都可以问我</view>
    </view>

    <view
      class="msg-row msg-row--{{item.role}}"
      wx:for="{{messages}}"
      wx:key="localId"
      id="msg-{{item.localId}}"
    >
      <view class="bubble">
        <text wx:if="{{item.content}}" class="bubble-text" user-select>{{item.content}}</text>
        <text wx:elif="{{sending && !item.stopped}}" class="bubble-text bubble-text--typing">正在回答…</text>

        <!-- 主动停止提示 -->
        <view wx:if="{{item.stopped}}" class="stopped-tip">已停止生成</view>

        <!-- 参考资料 -->
        <view wx:if="{{item.role === 'assistant' && item.sources.length}}" class="sources">
          <view class="sources-title">参考资料</view>
          <view class="source-item" wx:for="{{item.sources}}" wx:for-item="src" wx:key="id">
            <view class="source-head">
              <text wx:if="{{src.category}}" class="source-category">{{src.category}}</text>
              <text class="source-title">{{src.title}}</text>
            </view>
            <view wx:if="{{src.content}}" class="source-content">{{src.content}}</view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 底部输入栏 -->
  <view class="input-bar">
    <input
      class="input"
      value="{{inputValue}}"
      placeholder="请输入你的问题"
      confirm-type="send"
      bindinput="onInput"
      bindconfirm="onSend"
    />
    <button
      wx:if="{{sending}}"
      class="stop-btn"
      size="mini"
      bindtap="onStop"
    >停止</button>
    <button
      wx:else
      class="send-btn"
      size="mini"
      disabled="{{!inputValue}}"
      bindtap="onSend"
    >发送</button>
  </view>

  <!-- ==================== F14-A 侧边栏 ==================== -->
  <!-- 遮罩：点击关闭。收起态由 WXSS 置 visibility:hidden，不拦截触摸 -->
  <view
    class="sidebar-mask {{sidebarOpen ? 'sidebar-mask--open' : ''}}"
    bindtap="onMaskTap"
  ></view>

  <!-- 面板：从左滑出；支持滑动关闭（向右滑坡阈值 / 向左拖跟手，见 chat.js） -->
  <view
    class="sidebar-panel xj-glass xj-glass-strong {{sidebarOpen ? 'sidebar-panel--open' : ''}} {{sidebarDragging ? 'sidebar-panel--dragging' : ''}}"
    style="{{sidebarStyle}}"
    bindtouchstart="onSidebarTouchStart"
    bindtouchmove="onSidebarTouchMove"
    bindtouchend="onSidebarTouchEnd"
    bindtouchcancel="onSidebarTouchCancel"
  >
    <view class="sidebar-head">
      <button class="sidebar-new xj-glass" bindtap="onNewConversation">+ 新建会话</button>
    </view>

    <scroll-view class="sidebar-list" scroll-y>
      <!-- 刷新时保留旧列表（只在「还没有任何数据」时占位），避免每次展开都闪一下「加载中」 -->
      <view wx:if="{{convLoading && conversations.length === 0}}" class="sidebar-tip">加载中…</view>

      <block wx:elif="{{convError && conversations.length === 0}}">
        <view class="sidebar-tip">{{convError}}</view>
        <button class="sidebar-retry" bindtap="fetchConversations">重试</button>
      </block>

      <block wx:elif="{{conversations.length === 0}}">
        <view class="sidebar-tip">暂无历史会话</view>
      </block>

      <block wx:else>
        <!-- 会话卡片：玻璃；点选切换，长按删除；当前会话高亮 -->
        <view
          class="sidebar-conv xj-glass-card {{item.id === conversationId ? 'sidebar-conv--active' : ''}}"
          wx:for="{{conversations}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onTapConversation"
          bindlongpress="onConvLongPress"
        >
          <view class="sidebar-conv-title">{{item.title}}</view>
          <view class="sidebar-conv-time">{{item.time}}</view>
        </view>
      </block>
    </scroll-view>

    <!-- 底部操作：设置（F17 交付前为次级占位入口，点击给明确提示）/ 清空历史 -->
    <view class="sidebar-foot">
      <button class="sidebar-action sidebar-action--secondary" bindtap="onSettingsEntry">设置</button>
      <button class="sidebar-action" bindtap="onClearHistory">清空历史</button>
    </view>
  </view>
</view>
