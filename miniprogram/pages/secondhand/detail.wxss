/* 二手商品详情（F9-A） */
.top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
}
.price {
  font-size: 36rpx;
  color: #e5484d;
  font-weight: 700;
}
.tags {
  margin-top: 20rpx;
}
.tag-cat {
  background: #eef5fc;
  color: #4A90D9;
  margin-right: 12rpx;
}
.tag-gray {
  background: #f2f2f2;
  color: #999999;
  margin-right: 12rpx;
}
.tag-green {
  background: #eafaf1;
  color: #2eb872;
}
.desc {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}
.seller {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #999999;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}
.remark-label {
  font-size: 26rpx;
  color: #666666;
}
.remark-input {
  margin-top: 12rpx;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.buy-btn {
  width: 100%;
  margin-top: 24rpx;
}
