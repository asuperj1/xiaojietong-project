<!-- 校园地图（F9-C） -->
<view class="xj-page">
  <view class="topbar">
    <input class="search" placeholder="搜索地点名称" value="{{q}}" bindinput="onSearchInput" confirm-type="search" bindconfirm="onSearch" />
    <view class="nearby-btn" bindtap="onNearby">附近</view>
  </view>

  <view class="tabs">
    <view class="tab {{catIndex === index ? 'tab-active' : ''}}" wx:for="{{cats}}" wx:key="*this" data-index="{{index}}" bindtap="onCatChange">{{item}}</view>
  </view>

  <view class="xj-card">
    <view class="sec-title">校园建筑</view>
    <view class="building-item" wx:for="{{buildings}}" wx:key="id" data-id="{{item.id}}" bindtap="onBuildingTap">
      <text>{{item.name}}</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="xj-loading">加载中…</view>

  <block wx:elif="{{error}}">
    <view class="xj-empty">
      <text class="xj-empty-icon">⚠️</text>{{error}}
      <view><button class="xj-btn-plain retry" bindtap="fetch">重试</button></view>
    </view>
  </block>

  <block wx:elif="{{items.length === 0}}">
    <view class="xj-empty"><text class="xj-empty-icon">🗺️</text>暂无地点数据</view>
  </block>

  <block wx:else>
    <view class="xj-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="onPoiTap">
      <view class="poi-name">{{item.name}}</view>
      <view class="poi-sub">{{item.category}}<text wx:if="{{item.floor}}"> · {{item.floor}} 楼</text><text wx:if="{{item.distance}}"> · {{item.distance}} 米</text></view>
    </view>
  </block>
</view>
