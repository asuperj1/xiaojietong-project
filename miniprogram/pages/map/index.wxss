/* 校园地图（F9-C） */
.topbar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
}
.search {
  flex: 1;
  height: 68rpx;
  background: #ffffff;
  border-radius: 34rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.nearby-btn {
  margin-left: 16rpx;
  color: #4A90D9;
  font-size: 28rpx;
}
.tabs {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx 16rpx;
}
.tab {
  font-size: 26rpx;
  color: #666666;
  padding: 8rpx 20rpx;
  margin: 0 8rpx 8rpx 0;
  border-radius: 28rpx;
  background: #ffffff;
}
.tab-active {
  background: #4A90D9;
  color: #ffffff;
}
.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}
.building-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  font-size: 28rpx;
  color: #333333;
  border-bottom: 1rpx solid #f5f5f5;
}
.building-item:last-child {
  border-bottom: none;
}
.arrow {
  color: #cccccc;
  font-size: 36rpx;
}
.poi-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}
.poi-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
}
.retry {
  margin: 24rpx auto 0;
  width: 240rpx;
}
