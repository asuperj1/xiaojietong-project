<!-- 图书馆座位选择（F6） -->
<view class="xj-page">
  <view class="xj-card">
    <view class="room-title">{{roomName}}</view>
    <view class="pick-row">
      <text class="pick-label">日期</text>
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="pick-value">{{date}}</view>
      </picker>
    </view>
    <view class="pick-row">
      <text class="pick-label">时间</text>
      <picker mode="time" value="{{beginTime}}" bindchange="onBeginChange">
        <view class="pick-value">{{beginTime}}</view>
      </picker>
      <text class="pick-sep">至</text>
      <picker mode="time" value="{{endTime}}" bindchange="onEndChange">
        <view class="pick-value">{{endTime}}</view>
      </picker>
    </view>
    <view class="legend">
      <text class="lg-item"><text class="dot dot-free"></text>可用</text>
      <text class="lg-item"><text class="dot dot-used"></text>已占用</text>
      <text class="lg-item"><text class="dot dot-sel"></text>已选择</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="xj-loading">加载中…</view>

  <block wx:elif="{{error}}">
    <view class="xj-empty">
      <text class="xj-empty-icon">⚠️</text>{{error}}
      <view><button class="xj-btn-plain retry" bindtap="fetchSeats">重试</button></view>
    </view>
  </block>

  <block wx:elif="{{seats.length === 0}}">
    <view class="xj-empty"><text class="xj-empty-icon">💺</text>该日期暂无可用座位</view>
  </block>

  <block wx:else>
    <view class="seat-grid">
      <view
        wx:for="{{seats}}"
        wx:key="id"
        class="seat {{item.reserved ? 'seat-used' : ''}} {{item.id === selectedId ? 'seat-selected' : ''}}"
        data-id="{{item.id}}"
        bindtap="onSeatTap"
      >
        <view class="seat-no">{{item.seat_no}}</view>
        <view class="seat-tag" wx:if="{{item.is_window}}">靠窗</view>
        <view class="seat-tag" wx:elif="{{item.has_power}}">插座</view>
      </view>
    </view>
    <view class="foot">
      <button class="xj-btn-primary reserve-btn" disabled="{{!selectedId || submitting}}" bindtap="onReserve">确认预约</button>
    </view>
  </block>
</view>
