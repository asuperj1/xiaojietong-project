/* 查空教室（F5） */
.filter-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.filter-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.filter-label {
  width: 120rpx;
  color: #666666;
  font-size: 28rpx;
}
.filter-picker {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.picker-value {
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
}
.room-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}
.room-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #999999;
}
.room-tags {
  margin-top: 16rpx;
}
.tag-blue {
  background: #eef5fc;
  color: #4A90D9;
  margin-right: 12rpx;
}
.tag-green {
  background: #eafaf1;
  color: #2eb872;
  margin-right: 12rpx;
}
.tag-gray {
  background: #f2f2f2;
  color: #999999;
  margin-right: 12rpx;
}
.retry {
  margin: 24rpx auto 0;
  width: 240rpx;
}
