/* 我的座位预约（F6） */
.top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.seat-no {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}
.status-tag {
  background: #eef5fc;
  color: #4A90D9;
}
.room {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #666666;
}
.time {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #999999;
}
.cancel-btn {
  margin-top: 20rpx;
  width: 200rpx;
}
.retry {
  margin: 24rpx auto 0;
  width: 240rpx;
}
