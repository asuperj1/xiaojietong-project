<!-- 我的帖子（F7） -->
<view class="xj-page">
  <view wx:if="{{loading}}" class="xj-loading">加载中…</view>

  <block wx:elif="{{error}}">
    <view class="xj-empty">
      <text class="xj-empty-icon">⚠️</text>{{error}}
      <view><button class="xj-btn-plain retry" bindtap="fetch">重试</button></view>
    </view>
  </block>

  <block wx:elif="{{items.length === 0}}">
    <view class="xj-empty"><text class="xj-empty-icon">📝</text>还没有发过帖子</view>
  </block>

  <block wx:else>
    <view class="xj-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="onItemTap">
      <view class="top">
        <text class="title">{{item.title}}</text>
        <text class="xj-tag {{item.auditOk ? 'tag-ok' : (item.auditBad ? 'tag-bad' : 'tag-wait')}}">{{item.auditText}}</text>
      </view>
      <view class="meta">{{item.category}} · {{item.time}} · 👍{{item.like_count}} · 💬{{item.comment_count}}</view>
    </view>
  </block>
</view>
