/* 论坛（F7） */
.forum-page {
  padding-bottom: 140rpx;
}
.tabs {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #ffffff;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab {
  font-size: 26rpx;
  color: #666666;
  padding: 8rpx 20rpx;
  margin-right: 8rpx;
  border-radius: 28rpx;
}
.tab-active {
  background: #4A90D9;
  color: #ffffff;
}
.tab-mine {
  margin-left: auto;
  font-size: 26rpx;
  color: #4A90D9;
}
.topic-top {
  display: flex;
  align-items: center;
}
.topic-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}
.tag-hot {
  background: #fdeaea;
  color: #e5484d;
}
.topic-summary {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
}
.topic-meta {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #999999;
}
.meta-item {
  margin-right: 20rpx;
}
.meta-right {
  margin-left: auto;
}
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 80rpx;
  background: #4A90D9;
  color: #ffffff;
  padding: 20rpx 32rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  box-shadow: 0 6rpx 16rpx rgba(74, 144, 217, 0.4);
}
.list-end {
  text-align: center;
  color: #cccccc;
  font-size: 24rpx;
  padding: 20rpx 0;
}
.retry {
  margin: 24rpx auto 0;
  width: 240rpx;
}
