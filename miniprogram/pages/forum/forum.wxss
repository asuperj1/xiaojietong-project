/* 论坛（F7） */
.forum-page {
  padding-bottom: 140rpx;
}
.tabs {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #ffffff;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab {
  font-size: 26rpx;
  color: #666666;
  padding: 8rpx 20rpx;
  margin-right: 8rpx;
  border-radius: 28rpx;
}
.tab-active {
  background: #4A90D9;
  color: #ffffff;
}
.tab-mine {
  margin-left: auto;
  font-size: 26rpx;
  color: #4A90D9;
}
.topic-top {
  display: flex;
  align-items: center;
}
.topic-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}
.tag-hot {
  background: #fdeaea;
  color: #e5484d;
}
.topic-summary {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
}
.topic-meta {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #999999;
}
.meta-item {
  margin-right: 20rpx;
}
.meta-right {
  margin-left: auto;
}
.fab {
  position: fixed;
  right: 32rpx;
  /* F12：抬到自定义 TabBar 之上，否则会被 110rpx 高的底栏盖住（原生 tabBar 时代 80rpx 够用）。
     126rpx = 底栏 110rpx + 16rpx 间距；改动需同步 custom-tab-bar/index.wxss 的 .tabbar 高度。 */
  bottom: calc(126rpx + env(safe-area-inset-bottom));
  background: #4A90D9;
  color: #ffffff;
  padding: 20rpx 32rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  box-shadow: 0 6rpx 16rpx rgba(74, 144, 217, 0.4);
}
.list-end {
  text-align: center;
  color: #cccccc;
  font-size: 24rpx;
  padding: 20rpx 0;
}
.retry {
  margin: 24rpx auto 0;
  width: 240rpx;
}

/* F12：底部留白 = 抬高后的悬浮按钮所需空间(≈202rpx) + 底栏呼吸位，避免最后一条帖子被按钮/底栏压住。
   （覆盖文件开头 .forum-page 的 140rpx：那是原生 tabBar 时代的取值。） */
.forum-page {
  padding-bottom: calc(250rpx + env(safe-area-inset-bottom));
}
