/* 我的（F8） */
.profile {
  display: flex;
  align-items: center;
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #eef5fc;
}
.avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #4A90D9;
  font-size: 48rpx;
  font-weight: 600;
}
.profile-info {
  margin-left: 24rpx;
  flex: 1;
}
.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}
.sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999999;
}
.menu {
  padding: 0 24rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  font-size: 30rpx;
  color: #333333;
  border-bottom: 1rpx solid #f5f5f5;
}
.menu-item:last-child {
  border-bottom: none;
}
.arrow {
  color: #cccccc;
  font-size: 36rpx;
}
.logout-wrap {
  padding: 24rpx;
}
.logout-btn {
  width: 100%;
  color: #e5484d;
  border-color: #e5484d;
}
.retry {
  margin: 24rpx auto 0;
  width: 240rpx;
}
