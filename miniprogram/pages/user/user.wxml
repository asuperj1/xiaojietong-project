<!-- 我的（需求 9 / F17）—— 个人信息区（头像 + 昵称 + 学号）+ 玻璃分割列表
     依据：docs/二阶段整改方案-前端UI重构与后端支撑.md §2.5
     玻璃：.xj-glass-card / .xj-page-bg 来自 app.wxss 全局引入的 styles/glass.wxss；
           根节点 .is-glass-fallback 由 user.js 按 F10 能力探测结果挂载。
     注意：根节点必须保留 .xj-page 类 —— F12 校验 G 段按「根节点真实类 + 底部留白数值」
           双重断言，底栏才不会被内容压住（tools/verify_f12_tabbar_poc.js）。 -->
<view class="xj-page xj-page-bg {{glassFallback ? 'is-glass-fallback' : ''}}">
  <view wx:if="{{loading}}" class="xj-loading">加载中…</view>

  <block wx:elif="{{error}}">
    <view class="xj-empty">
      <text class="xj-empty-icon">⚠️</text>{{error}}
      <view><button class="xj-btn-plain me-retry" bindtap="fetch">重试</button></view>
    </view>
  </block>

  <block wx:else>
    <!-- 需求 9-1：头像 + 昵称 + 学号；点击**整块**进入资料设置页（可改头像/昵称/学号） -->
    <view
      class="me-profile xj-glass-card"
      bindtap="onProfileTap"
      hover-class="me-pressed"
      hover-start-time="20"
      hover-stay-time="140"
    >
      <image wx:if="{{user.avatar}}" class="me-avatar" src="{{user.avatar}}" mode="aspectFill" />
      <view wx:else class="me-avatar me-avatar-text">{{avatarText}}</view>
      <view class="me-info">
        <view class="me-nickname">{{user.nickname || '未设置昵称'}}</view>
        <view class="me-sub">{{studentNoText}}</view>
        <view class="me-sub" wx:if="{{user.major || user.grade || user.campus}}">
          <text wx:if="{{user.major}}">{{user.major}}</text><text wx:if="{{user.grade}}"> · {{user.grade}}</text><text wx:if="{{user.campus}}"> · {{user.campus}}</text>
        </view>
      </view>
      <text class="me-arrow">›</text>
    </view>

    <!-- 需求 9-2：保留原列表（我的帖子/二手/座位预约/兼职申请/收藏/任务中心）
         需求 9-3：列表单元格用玻璃底 + 细分割线（见 user.wxss .me-menu-item） -->
    <view class="me-menu xj-glass-card">
      <view
        class="me-menu-item"
        wx:for="{{menus}}"
        wx:key="name"
        data-url="{{item.url}}"
        bindtap="onMenuTap"
        hover-class="me-menu-pressed"
        hover-start-time="20"
        hover-stay-time="140"
      >
        <text>{{item.name}}</text>
        <text class="me-arrow">›</text>
      </view>
    </view>

    <view class="me-logout-wrap">
      <button class="xj-btn-plain me-logout" bindtap="logout">退出登录</button>
    </view>
  </block>
</view>
