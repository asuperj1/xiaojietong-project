/* ============================================================
   资料设置（需求 9 / F17）—— 上传头像 · 改昵称 · 绑学号
   依据：docs/二阶段整改方案-前端UI重构与后端支撑.md §2.5、视觉规范 §1.1 / §1.3
   玻璃与令牌：复用 app.wxss 全局引入的 styles/glass.wxss / styles/tokens.wxss；
              所有 var() 均带 literal fallback（令牌取不到也不掉样式）。
   ⚠️ 本页不是 Tab 页：自定义 TabBar 不渲染 → **不**叠加 F12 的 110rpx 底栏留白，
      只需为底部安全区留白（见文件末尾 .pf-page）。
   ============================================================ */

.pf-page {
  min-height: 100vh;
  padding: 24rpx 0 0;
  padding: var(--xj-space-md, 24rpx) 0 0;
  box-sizing: border-box;
}

/* 卡片外边距与「我的」页保持一致（库类 .xj-glass-card 只给圆角与内边距） */
.pf-card {
  margin: 0 24rpx 20rpx;
  margin: 0 var(--xj-space-md, 24rpx) 20rpx;
}

/* ---- 头像行 ---- */
.pf-avatar-row {
  display: flex;
  align-items: center;
  transition: transform var(--xj-duration-fast, 150ms) var(--xj-ease-press, cubic-bezier(0.4, 0, 0.2, 1));
}
.pf-pressed {
  transform: scale(0.96);
}
.pf-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: rgba(74, 144, 217, 0.12);
  background: var(--xj-color-primary-soft, rgba(74, 144, 217, 0.12));
  flex-shrink: 0;
}
.pf-avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #4A90D9;
  color: var(--xj-color-primary, #4A90D9);
  font-size: 48rpx;
  font-weight: 600;
  font-weight: var(--xj-font-weight-semibold, 600);
}
.pf-avatar-info {
  margin-left: 24rpx;
  margin-left: var(--xj-space-md, 24rpx);
  flex: 1;
  min-width: 0;
}
.pf-avatar-title {
  font-size: 30rpx;
  color: #1F2329;
  color: var(--xj-text-primary, #1F2329);
  line-height: var(--xj-line-height, 1.6);
}
.pf-avatar-hint {
  margin-top: 4rpx;
  font-size: 24rpx;
  font-size: var(--xj-font-size-sm, 24rpx);
  color: #8A9099;
  color: var(--xj-text-secondary, #8A9099);
  line-height: var(--xj-line-height, 1.6);
}
.pf-arrow {
  color: #C4C9D0;
  color: var(--xj-text-disabled, #C4C9D0);
  font-size: 36rpx;
  line-height: 1;
  padding-left: 16rpx;
  padding-left: var(--xj-space-sm, 16rpx);
}

/* ---- 表单字段（标签 + 输入框，底部分割线与「我的」列表同款发丝线）---- */
.pf-field {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid rgba(31, 35, 41, 0.06);
  border-bottom: 1rpx solid var(--xj-border-hairline, rgba(31, 35, 41, 0.06));
}
/* 最后一个字段不画线：否则会与卡片底边叠成双线
   （用类而不是 :last-of-type —— WXSS 里同级元素都是 view，:last-of-type 只命中末尾那个） */
.pf-field-last {
  border-bottom: none;
}
.pf-label {
  width: 120rpx;
  font-size: 30rpx;
  color: #1F2329;
  color: var(--xj-text-primary, #1F2329);
  line-height: var(--xj-line-height, 1.6);
  flex-shrink: 0;
}
/* 输入框走统一玻璃规范（§1.1「输入框 24rpx」+ §7 验收 #1「全部…输入框走统一玻璃规范」）：
   玻璃底/发丝边/柔和阴影由库类 .xj-glass 提供（WXML 上与该类同时出现），
   这里只补几何与排版 —— 复合类 (0,2,0) > 库的 (0,1,0)，与声明顺序无关。 */
.pf-input {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  color: #1F2329;
  color: var(--xj-text-primary, #1F2329);
}
.pf-input.xj-glass {
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  border-radius: var(--xj-radius-input, 24rpx);
  box-sizing: border-box;
  text-align: left;
}
.pf-placeholder {
  color: #C4C9D0;
  color: var(--xj-text-disabled, #C4C9D0);
}
.pf-hint {
  padding: 16rpx 0 0;
  padding: var(--xj-space-sm, 16rpx) 0 0;
  font-size: 24rpx;
  font-size: var(--xj-font-size-sm, 24rpx);
  color: #8A9099;
  color: var(--xj-text-secondary, #8A9099);
  line-height: var(--xj-line-height, 1.6);
}
/* 错误态沿用主色系之外的告警红（与退出登录同色），保证在玻璃底上可读 */
.pf-error {
  padding: 12rpx 0 0;
  font-size: 24rpx;
  font-size: var(--xj-font-size-sm, 24rpx);
  color: #e5484d;
  line-height: var(--xj-line-height, 1.6);
}
.pf-form-error {
  text-align: center;
}
.pf-actions {
  padding: 24rpx 24rpx 0;
  padding: var(--xj-space-md, 24rpx) var(--xj-space-md, 24rpx) 0;
}
.pf-save {
  width: 100%;
}
.pf-retry {
  margin: 24rpx auto 0;
  width: 240rpx;
}

/* 非 Tab 页：只为底部安全区留白（TabBar 不会渲染，故不叠加 F12 的 134rpx 留白）。
   固定底部手势条会压住「保存」按钮，故必须显式叠加 env(safe-area-inset-bottom)。 */
.pf-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}
