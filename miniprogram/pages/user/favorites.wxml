<!-- 我的收藏（F8） -->
<view class="xj-page">
  <view class="seg">
    <view class="seg-item {{tab === 'topic' ? 'seg-active' : ''}}" data-tab="topic" bindtap="onTab">收藏的帖子</view>
    <view class="seg-item {{tab === 'item' ? 'seg-active' : ''}}" data-tab="item" bindtap="onTab">收藏的二手</view>
  </view>

  <view wx:if="{{loading}}" class="xj-loading">加载中…</view>

  <block wx:elif="{{error}}">
    <view class="xj-empty">
      <text class="xj-empty-icon">⚠️</text>{{error}}
      <view><button class="xj-btn-plain retry" bindtap="fetch">重试</button></view>
    </view>
  </block>

  <block wx:elif="{{items.length === 0}}">
    <view class="xj-empty"><text class="xj-empty-icon">⭐</text>暂无收藏</view>
  </block>

  <block wx:else>
    <view class="xj-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" data-tab="{{tab}}" bindtap="onItemTap">
      <view class="fav-title">{{item.title}}</view>
      <view class="fav-meta">
        <text wx:if="{{tab === 'item'}}" class="fav-price">¥{{item.price}}</text>
        <text wx:if="{{item.category}}">{{item.category}}</text>
        <text wx:if="{{tab === 'topic'}}">👍{{item.likeCount}} · 💬{{item.commentCount}}</text>
        <text class="fav-time">{{item.time}}</text>
      </view>
    </view>
  </block>
</view>
