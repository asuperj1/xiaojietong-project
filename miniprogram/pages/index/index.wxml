<!-- 首页（F3）：顶部标题 + 欢迎区 + 搜索框 + 快捷指令 + 10 宫格 -->
<view class="page">
  <!-- 顶部标题 -->
  <view class="header">
    <text class="brand">校捷通</text>
  </view>

  <!-- 欢迎区 -->
  <view class="welcome">
    <view class="welcome-title">你好，同学 👋</view>
    <view class="welcome-sub">校园一站式智能服务，从这里开始</view>
  </view>

  <!-- 搜索框：提交后切换到 AI Tab -->
  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      placeholder="搜索服务，或直接问 AI"
      confirm-type="search"
      value="{{keyword}}"
      bindinput="onKeywordInput"
      bindconfirm="onSearch"
    />
  </view>

  <!-- 快捷指令 -->
  <view class="quick-row">
    <view
      class="quick-chip {{quickLoading ? 'quick-chip--disabled' : ''}}"
      wx:for="{{quickCommands}}"
      wx:key="*this"
      data-keyword="{{item}}"
      bindtap="onQuickTap"
    >⚡ {{item}}</view>
  </view>

  <!-- 10 宫格 -->
  <view class="grid-card">
    <view
      class="grid-item"
      wx:for="{{gridItems}}"
      wx:key="id"
      data-url="{{item.url}}"
      data-tab="{{item.tab}}"
      bindtap="onGridTap"
    >
      <image class="grid-icon" src="{{item.icon}}" mode="aspectFit"></image>
      <view class="grid-name">{{item.name}}</view>
    </view>
  </view>
</view>
