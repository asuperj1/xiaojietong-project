# ============================================================
# 校捷通 · 后端环境变量模板（B12）
# 用法：复制为 backend/.env 后按本机情况修改；
#       密码 / 密钥一律使用占位符，禁止把真实值提交进仓库。
# 说明：所有配置项前缀 XJT_，与 app/core/config.py 一一对应。
# ============================================================

# ---- 应用 ----
XJT_APP_NAME=校捷通
XJT_DEBUG=false
XJT_API_PREFIX=/api/v1
# dev=本地开发（宽松校验）；prod=生产（强制安全硬校验：
# JWT 密钥强度 / 微信凭据 / CORS 白名单 / 限流开关，不合规拒绝启动）
XJT_ENV=dev

# ---- 数据库（MySQL，经 C++ jt_db 连接池）----
XJT_DB_HOST=127.0.0.1
# 本机绿色版 MySQL 为 3306；团队开发机为 3307，按实际修改
XJT_DB_PORT=3306
XJT_DB_USER=root
XJT_DB_PASSWORD=<你的MySQL密码>
XJT_DB_NAME=xiaojietong
# 连接池上下限：池上限应 >= FastAPI 同步线程池上限（AnyIO 默认 40）
XJT_DB_MIN_CONN=4
XJT_DB_MAX_CONN=32

# ---- 安全（JWT）----
# 生产必须为 >=32 字节随机值，生成示例：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
XJT_JWT_SECRET=<生产环境必填-随机密钥>
XJT_JWT_ALGORITHM=HS256
XJT_JWT_EXPIRE_SECONDS=7200
XJT_JWT_REFRESH_EXPIRE_SECONDS=604800

# ---- 微信小程序 ----
# 留空则开发态使用模拟 openid（生产环境必须配置，否则拒绝启动）
XJT_WX_APPID=<微信AppID>
XJT_WX_SECRET=<微信AppSecret>

# ---- CORS ----
# 逗号分隔的允许来源；生产不允许 * 通配（XJT_ENV=prod 时会拒绝启动）
XJT_CORS_ORIGINS=*

# ---- 接口限流 ----
XJT_RATE_LIMIT_ENABLED=true
XJT_RATE_LIMIT_PER_MINUTE=300
XJT_RATE_LIMIT_LOGIN_PER_MINUTE=10

# ---- AI 推理服务（Ollama）----
XJT_OLLAMA_BASE_URL=http://127.0.0.1:11434
# 校园领域微调模型 xjt-3b；未部署微调模型时可用基座 qwen2.5:3b
XJT_OLLAMA_MODEL=xjt-3b

# ---- RAG 检索增强 ----
XJT_RAG_EMBED_MODEL=bge-m3
XJT_RAG_EMBED_DIM=1024
XJT_RAG_CHUNK_SIZE=600
XJT_RAG_CHUNK_OVERLAP=100
XJT_RAG_EMBED_BATCH=16
XJT_RAG_TOP_K=3
XJT_RAG_SCORE_THRESHOLD=0.35
XJT_RAG_VECTOR_DIR=data/rag

# ---- 文件存储与上传访问（B14）----
# local=本地文件系统；s3/oss=对象存储（接口已预留，接入 SDK 后启用）
XJT_STORAGE_BACKEND=local
# 上传资源访问签名（默认开启）：/static/uploads 需携带 ?e=过期&s=签名 才可访问
XJT_UPLOAD_SIGNED_URL_ENABLED=true
XJT_UPLOAD_URL_TTL_SECONDS=604800
# 留空则从 JWT 密钥派生（生产建议独立配置）
XJT_UPLOAD_URL_SECRET=<可选-独立签名密钥>

# ---- 异步任务（B15：Celery + Redis）----
# false=无 Redis 环境（eager 就地同步执行，接口行为与旧版一致）
# true=真异步：先启动 Redis，再启动 worker（Windows 必须 -P solo）：
#   celery -A app.core.celery_app:celery_app worker -l info -P solo
XJT_CELERY_ENABLED=false
XJT_CELERY_BROKER_URL=redis://127.0.0.1:6379/0
XJT_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
